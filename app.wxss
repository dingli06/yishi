page {
  --ink: #262822;
  --muted: #74766d;
  --paper: #f5f1e8;
  --card: #fffdf7;
  --line: #ded9cd;
  --green: #3f654f;
  --green-deep: #294838;
  --orange: #e56f45;
  --yellow: #f4bd55;
  min-height: 100%;
  color: var(--ink);
  background: var(--paper);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after { border: none; }

.safe-bottom { height: calc(36rpx + env(safe-area-inset-bottom)); }

.page-shell { min-height: 100vh; box-sizing: border-box; }

.top-actions { display: flex; gap: 14rpx; }

.icon-button {
  min-width: 68rpx;
  height: 68rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  background: rgba(255,255,255,.76);
  border: 1rpx solid rgba(38,40,34,.12);
  border-radius: 999rpx;
  font-size: 25rpx;
  line-height: 1;
}

.primary-button {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffdf7;
  background: var(--green-deep);
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(41,72,56,.18);
}

.secondary-button {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--green-deep);
  background: transparent;
  border: 2rpx solid var(--green-deep);
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.eyebrow {
  color: var(--orange);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.section-title { font-family: Georgia, "Songti SC", serif; font-size: 38rpx; font-weight: 700; }

.empty-state { padding: 110rpx 50rpx; text-align: center; color: var(--muted); }
.empty-mark { margin-bottom: 24rpx; font-family: Georgia, serif; font-size: 82rpx; color: var(--green); }
