{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jinriheshi:schema:recommendation-request:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_total_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "available_equipment": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "pantry_mode": {
          "enum": [
            "any",
            "only_owned",
            "allow_missing"
          ]
        },
        "owned_ingredients": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "max_missing_ingredients": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "required_ingredients": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "excluded_ingredients": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "cuisines_only": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "meal_forms": {
          "type": "array",
          "items": {
            "enum": [
              "dish",
              "staple",
              "soup",
              "breakfast",
              "drink",
              "dessert",
              "condiment",
              "semi_finished"
            ]
          },
          "uniqueItems": true
        },
        "standalone_meal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "servings": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed_prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "tastes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "cuisines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "textures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "priority_ingredients": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "novelty": {
          "enum": [
            "any",
            "familiar",
            "new"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "seen_dish_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "recently_cooked_dish_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "favorite_dish_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}
