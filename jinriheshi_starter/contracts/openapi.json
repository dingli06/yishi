{
  "openapi": "3.1.0",
  "info": {
    "title": "今日何食 P0 API（待开发契约）",
    "version": "0.1.0",
    "description": "本包只有离线数据工具和纯规则参考，没有已运行的HTTP服务。生产状态和用户历史由服务端决定。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "SessionToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Options": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          },
          "published_recipe_count": {
            "type": "integer",
            "minimum": 0
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "reviewed_candidate_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "enabled",
                "reviewed_candidate_count",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "selection": {
                  "enum": [
                    "single",
                    "multiple"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "enabled": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "value",
                      "label",
                      "enabled"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "label",
                "selection",
                "options"
              ],
              "additionalProperties": false
            }
          },
          "defaults": {
            "type": "object",
            "properties": {
              "constraints": {
                "type": "object",
                "properties": {
                  "max_total_minutes": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10080
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "available_equipment": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "pantry_mode": {
                    "enum": [
                      "any",
                      "only_owned",
                      "allow_missing"
                    ]
                  },
                  "owned_ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "max_missing_ingredients": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "required_ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "excluded_ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "cuisines_only": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "meal_forms": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "dish",
                        "staple",
                        "soup",
                        "breakfast",
                        "drink",
                        "dessert",
                        "condiment",
                        "semi_finished"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "standalone_meal": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "servings": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "confirmed_prerequisites": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "preferences": {
                "type": "object",
                "properties": {
                  "tastes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "cuisines": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "textures": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "priority_ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "uniqueItems": true
                  },
                  "novelty": {
                    "enum": [
                      "any",
                      "familiar",
                      "new"
                    ]
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "constraints",
              "preferences"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "published_recipe_count",
          "capabilities",
          "groups",
          "defaults"
        ],
        "additionalProperties": false
      },
      "PublicRecipe": {
        "type": "object",
        "properties": {
          "recipe_id": {
            "type": "string",
            "minLength": 1
          },
          "recipe_version": {
            "type": "string",
            "minLength": 1
          },
          "dish_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attribution": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "url",
                  "alt",
                  "attribution"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ingredient_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity_text": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "requirement": {
                  "enum": [
                    "required",
                    "optional",
                    "alternative",
                    "unknown"
                  ]
                },
                "alternative_group": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "ingredient_id",
                "name",
                "quantity_text",
                "requirement",
                "alternative_group"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "position",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "tags": {
            "type": "object",
            "properties": {
              "tastes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              },
              "cuisines": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              },
              "textures": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              },
              "meal_form": {
                "enum": [
                  "dish",
                  "staple",
                  "soup",
                  "breakfast",
                  "drink",
                  "dessert",
                  "condiment",
                  "semi_finished",
                  "unknown"
                ]
              },
              "standalone_meal": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "tastes",
              "cuisines",
              "textures",
              "meal_form",
              "standalone_meal"
            ],
            "additionalProperties": false
          },
          "time": {
            "type": "object",
            "properties": {
              "source_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_estimate_minutes": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number",
                        "minimum": 0
                      },
                      "max": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "total_minutes": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number",
                        "minimum": 0
                      },
                      "max": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "active_minutes": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number",
                        "minimum": 0
                      },
                      "max": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "source_estimate",
                  "unknown",
                  "verified"
                ]
              }
            },
            "required": [
              "source_text",
              "source_estimate_minutes",
              "total_minutes",
              "active_minutes",
              "prerequisites",
              "status"
            ],
            "additionalProperties": false
          },
          "servings": {
            "type": "object",
            "properties": {
              "min": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "min",
              "max",
              "display_text"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "license": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "url",
              "license"
            ],
            "additionalProperties": false
          },
          "notices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "recipe_id",
          "recipe_version",
          "dish_id",
          "title",
          "image",
          "ingredients",
          "steps",
          "tags",
          "time",
          "servings",
          "source",
          "notices"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/v1/options": {
      "get": {
        "operationId": "getOptions",
        "summary": "返回枚举、默认值及已发布数据覆盖能力",
        "responses": {
          "200": {
            "description": "选项及能力，不启用数据不足的严格筛选",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Options"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "security": [
          {
            "SessionToken": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            },
            "description": "同用户、路由和key：同请求体重放同响应；不同体返回409。至少保留24小时。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "constraints": {
                    "type": "object",
                    "properties": {
                      "max_total_minutes": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10080
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "available_equipment": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]*$"
                            },
                            "uniqueItems": true
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "pantry_mode": {
                        "enum": [
                          "any",
                          "only_owned",
                          "allow_missing"
                        ]
                      },
                      "owned_ingredients": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "max_missing_ingredients": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "required_ingredients": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "excluded_ingredients": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "cuisines_only": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "meal_forms": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "dish",
                            "staple",
                            "soup",
                            "breakfast",
                            "drink",
                            "dessert",
                            "condiment",
                            "semi_finished"
                          ]
                        },
                        "uniqueItems": true
                      },
                      "standalone_meal": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "servings": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "confirmed_prerequisites": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  },
                  "preferences": {
                    "type": "object",
                    "properties": {
                      "tastes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "cuisines": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "textures": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "priority_ingredients": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "uniqueItems": true
                      },
                      "novelty": {
                        "enum": [
                          "any",
                          "familiar",
                          "new"
                        ]
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建推荐会话",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "session_id",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "无效条件",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "幂等键冲突",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/recommendations": {
      "post": {
        "operationId": "nextRecommendation",
        "security": [
          {
            "SessionToken": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            },
            "description": "同用户、路由和key：同请求体重放同响应；不同体返回409。至少保留24小时。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "expected_revision"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "description": "服务端读取会话和历史，生产仅published。原子选择并记录曝光；同key重试不能跳到下一道。客户端不能传mode、seed或context。",
        "responses": {
          "200": {
            "description": "结果或明确空结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recommendation_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
