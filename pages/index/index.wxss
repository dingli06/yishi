.page-shell { height: 100vh; display: flex; flex-direction: column; }
.scrollarea { flex: 1; overflow: hidden; }
.content { padding: 28rpx 34rpx 0; }
.brand-small { padding-left: 30rpx; font-family: Georgia, "Songti SC", serif; font-size: 31rpx; font-weight: 700; letter-spacing: 2rpx; white-space: nowrap; }
.hero { min-height: 300rpx; display: flex; align-items: center; justify-content: space-between; }
.hero-copy { display: flex; flex-direction: column; width: 67%; }
.hero-title { margin-top: 18rpx; font-family: Georgia, "Songti SC", serif; font-size: 59rpx; line-height: 1.18; font-weight: 700; letter-spacing: -2rpx; }
.hero-subtitle { margin-top: 18rpx; color: var(--muted); font-size: 27rpx; }
.bowl-art { position: relative; width: 210rpx; height: 220rpx; transform: rotate(3deg); }
.bowl-fill { position: absolute; left: 12rpx; top: 83rpx; width: 180rpx; height: 98rpx; display: flex; justify-content: center; color: #fff8e9; background: var(--orange); border-radius: 14rpx 14rpx 90rpx 90rpx; box-shadow: inset 0 9rpx 0 rgba(255,255,255,.2); font-family: Georgia, serif; font-size: 56rpx; font-weight: 700; }
.bowl-base { position:absolute; left: 70rpx; top: 181rpx; width: 70rpx; height: 13rpx; border-radius: 50%; background: #bd5335; }
.steam { position: absolute; top: 12rpx; width: 26rpx; height: 65rpx; border-left: 5rpx solid var(--green); border-radius: 50%; opacity: .55; }
.steam-one { left: 67rpx; transform: rotate(16deg); }.steam-two { left: 125rpx; top: 22rpx; transform: rotate(-15deg); }
.preview-banner { margin-bottom: 26rpx; padding: 19rpx 22rpx; display: flex; align-items: center; color: #765b2d; background: #f8e9c4; border-radius: 18rpx; font-size: 22rpx; }
.preview-dot { width: 13rpx; height: 13rpx; margin-right: 13rpx; background: var(--yellow); border: 4rpx solid #fff6dd; border-radius: 50%; }
.question-card { margin-bottom: 22rpx; padding: 28rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: 28rpx; box-shadow: 0 7rpx 22rpx rgba(48,45,37,.04); }
.question-head { margin-bottom: 23rpx; display: flex; align-items: baseline; }
.question-no { width: 50rpx; color: var(--orange); font-family: Georgia, serif; font-size: 23rpx; font-weight: 700; }
.question-title { flex: 1; font-size: 29rpx; font-weight: 650; }
.optional { color: #a29e94; font-size: 21rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { margin: 0; padding: 0 26rpx; height: 64rpx; color: #63655e; background: #f1eee6; border-radius: 999rpx; font-size: 25rpx; line-height: 64rpx; }
.chip.active { color: #fff; background: var(--green); box-shadow: 0 7rpx 15rpx rgba(63,101,79,.18); }
.ingredient-field { height: 80rpx; padding: 0 24rpx; display: flex; align-items: center; background: #f3f0e8; border-radius: 20rpx; }
.field-icon { margin-right: 16rpx; color: var(--green); font-size: 38rpx; }.ingredient-field input { flex: 1; font-size: 26rpx; }
.switch-row { margin-top: 24rpx; display: flex; justify-content: space-between; align-items: center; }.switch-row view { display:flex; flex-direction:column; }.switch-title { font-size:25rpx; }.switch-note { margin-top:6rpx; color:var(--muted); font-size:21rpx; }.switch-row switch { transform: scale(.82); }
.disabled-note { margin: 10rpx 8rpx 30rpx; padding: 20rpx; display:flex; flex-direction:column; gap:7rpx; color:#8d8c84; border-left:4rpx solid #cbc6b9; font-size:22rpx; }.disabled-note text:first-child { color:#696b64; font-weight:600; }
.start-button { margin: 0; }.arrow { margin-left: 14rpx; font-size: 35rpx; }
.state-panel { min-height: 76vh; padding: 80rpx 55rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; box-sizing:border-box; text-align:center; }
.loading-orbit { width:110rpx; height:110rpx; margin-bottom:38rpx; border:3rpx solid #c7d2c9; border-top-color:var(--green); border-radius:50%; animation:spin 1.2s linear infinite; }.loading-seed { width:24rpx; height:34rpx; margin:35rpx auto; background:var(--orange); border-radius:70% 15% 70% 25%; }
@keyframes spin { to { transform:rotate(360deg); } }
.loading-title,.state-title { font-family:Georgia,"Songti SC",serif; font-size:38rpx; font-weight:700; }.loading-sub,.state-copy { max-width:560rpx; margin-top:20rpx; color:var(--muted); font-size:25rpx; line-height:1.7; }.state-button { width:100%; margin-top:30rpx; }.state-button + .state-button { margin-top:18rpx; }
.result-content { padding-top:42rpx; }.result-head { margin-bottom:28rpx; display:flex; align-items:flex-end; justify-content:space-between; }.result-head>view { display:flex; flex-direction:column; gap:10rpx; }.result-kicker { font-family:Georgia,"Songti SC",serif; font-size:48rpx; font-weight:700; }.text-action { margin:0; padding:15rpx 0; color:var(--green); background:transparent; font-size:25rpx; line-height:1; }
.recipe-card { overflow:hidden; background:var(--card); border:1rpx solid var(--line); border-radius:34rpx; box-shadow:0 18rpx 45rpx rgba(40,44,36,.09); }.recipe-visual { position:relative; height:300rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; }.recipe-visual:before,.recipe-visual:after { content:""; position:absolute; width:240rpx; height:240rpx; border:2rpx solid rgba(255,255,255,.26); border-radius:50%; }.recipe-visual:after { width:170rpx; height:170rpx; }.tone-green { background:#71917a; }.tone-orange { background:#d87850; }.tone-yellow { background:#d1a850; }.tone-blue { background:#718a91; }.recipe-glyph { z-index:1; color:#fffaf0; font-family:Georgia,"Songti SC",serif; font-size:94rpx; font-weight:700; text-shadow:0 8rpx 22rpx rgba(0,0,0,.12); }.source-badge { position:absolute; left:20rpx; bottom:18rpx; padding:10rpx 15rpx; color:rgba(255,255,255,.9); background:rgba(30,36,30,.25); border-radius:12rpx; font-size:19rpx; }
.recipe-body { padding:30rpx; }.recipe-meta { display:flex; justify-content:space-between; color:var(--orange); font-size:22rpx; font-weight:600; }.recipe-title { margin-top:16rpx; display:block; font-family:Georgia,"Songti SC",serif; font-size:49rpx; font-weight:700; }.recipe-note { margin-top:8rpx; display:block; color:var(--muted); font-size:22rpx; }.reason-list { margin-top:26rpx; display:flex; flex-direction:column; gap:13rpx; }.reason { display:flex; align-items:flex-start; font-size:25rpx; line-height:1.5; }.reason-check { width:38rpx; color:var(--green); font-weight:700; }.notice-box { margin-top:24rpx; padding:20rpx; display:flex; flex-direction:column; gap:7rpx; color:#685c47; background:#f7edda; border-radius:18rpx; font-size:22rpx; line-height:1.55; }.notice-label { color:#9b5f3c; font-weight:700; }.card-actions { margin:27rpx 0 20rpx; display:flex; gap:14rpx; }.card-actions button { flex:1; height:72rpx; border-radius:20rpx; font-size:25rpx; line-height:72rpx; }.favorite-button { color:var(--orange); background:#fff1e8; }.favorite-button.saved { color:#fff; background:var(--orange); }.swap-button { color:var(--green); background:#e9f0e9; }.round-count { margin:25rpx 15rpx; display:block; color:var(--muted); font-size:21rpx; text-align:center; }
