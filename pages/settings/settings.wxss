.page-shell { height:100vh; display:flex; flex-direction:column; }.settings-scroll { flex:1; overflow:hidden; }.settings-content { padding:45rpx 34rpx 0; }.settings-title { margin-top:14rpx; display:block; font-family:Georgia,"Songti SC",serif; font-size:46rpx; font-weight:700; }.settings-intro { margin:17rpx 0 30rpx; display:block; color:var(--muted); font-size:23rpx; line-height:1.7; }.setting-card { margin-bottom:20rpx; padding:27rpx; display:flex; flex-direction:column; background:var(--card); border:1rpx solid var(--line); border-radius:26rpx; }.setting-label { font-size:28rpx; font-weight:650; }.setting-help { margin-top:9rpx; color:var(--muted); font-size:21rpx; line-height:1.55; }.setting-card textarea { width:100%; height:115rpx; margin-top:20rpx; padding:20rpx; box-sizing:border-box; background:#f2efe7; border-radius:17rpx; font-size:25rpx; }.capability-card { margin-bottom:14rpx; padding:22rpx 25rpx; display:flex; align-items:center; justify-content:space-between; background:#ebe7dd; border-radius:19rpx; }.capability-card view { display:flex; flex-direction:column; gap:5rpx; font-size:24rpx; }.capability-card view text:last-child { color:var(--muted); font-size:20rpx; }.status-off { padding:7rpx 12rpx; color:#77766e; background:#dcd7cc; border-radius:9rpx; font-size:19rpx; }.save-button { margin-top:30rpx; }.clear-button { margin:17rpx 0 0; height:75rpx; color:#a0503d; background:transparent; font-size:24rpx; line-height:75rpx; }.dev-tools { margin-top:26rpx; padding-top:24rpx; display:flex; align-items:center; justify-content:space-between; border-top:1rpx dashed #c8c2b5; color:var(--muted); font-size:20rpx; }.dev-tools button { margin:0; padding:0 18rpx; height:58rpx; color:#795c45; background:#eee4d7; border-radius:15rpx; font-size:20rpx; line-height:58rpx; }
