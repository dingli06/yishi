.page-shell { height:100vh; display:flex; flex-direction:column; }.list-scroll { flex:1; overflow:hidden; }.list-head { padding:45rpx 34rpx 28rpx; display:flex; flex-direction:column; gap:12rpx; }.list-head>text:last-child { color:var(--muted); font-size:23rpx; }.favorite-list { padding:0 34rpx; }.favorite-card { margin-bottom:18rpx; padding:18rpx; display:flex; align-items:center; gap:22rpx; background:var(--card); border:1rpx solid var(--line); border-radius:25rpx; }.favorite-glyph { width:118rpx; height:118rpx; flex:none; display:flex; align-items:center; justify-content:center; color:#fff; border-radius:20rpx; font-family:Georgia,"Songti SC",serif; font-size:44rpx; font-weight:700; }.tone-green { background:#71917a; }.tone-orange { background:#d87850; }.tone-yellow { background:#d1a850; }.tone-blue { background:#718a91; }.favorite-copy { flex:1; display:flex; flex-direction:column; gap:7rpx; color:var(--muted); font-size:20rpx; }.favorite-title { color:var(--ink); font-family:Georgia,"Songti SC",serif; font-size:31rpx; font-weight:700; }.chevron { color:#99978f; font-size:48rpx; }.empty-state { display:flex; flex-direction:column; gap:15rpx; }.empty-title { color:var(--ink); font-family:Georgia,"Songti SC",serif; font-size:35rpx; font-weight:700; }
