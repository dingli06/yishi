.page-shell { height:100vh; display:flex; flex-direction:column; }.detail-scroll { flex:1; overflow:hidden; }.detail-hero { position:relative; height:330rpx; display:flex; align-items:center; justify-content:center; }.tone-green { background:#71917a; }.tone-orange { background:#d87850; }.tone-yellow { background:#d1a850; }.tone-blue { background:#718a91; }.detail-glyph { color:#fffaf0; font-family:Georgia,"Songti SC",serif; font-size:115rpx; font-weight:700; }.version-pill { position:absolute; left:28rpx; bottom:24rpx; padding:11rpx 17rpx; color:#fff; background:rgba(30,35,30,.23); border-radius:999rpx; font-size:20rpx; }.detail-content { padding:34rpx; }.accepted-banner { margin-bottom:30rpx; padding:20rpx; display:flex; align-items:center; gap:18rpx; color:#315743; background:#e4eee5; border-radius:20rpx; }.accepted-banner>text { width:42rpx; height:42rpx; color:#fff; background:var(--green); border-radius:50%; text-align:center; line-height:42rpx; }.accepted-banner view { display:flex; flex-direction:column; gap:4rpx; font-size:24rpx; }.accepted-banner view text:last-child { color:#698071; font-size:20rpx; }.detail-title { margin-top:13rpx; display:block; font-family:Georgia,"Songti SC",serif; font-size:57rpx; font-weight:700; }.detail-meta { margin-top:27rpx; padding:25rpx 0; display:flex; border-top:1rpx solid var(--line); border-bottom:1rpx solid var(--line); }.detail-meta view { width:50%; display:flex; flex-direction:column; }.detail-meta view+view { padding-left:28rpx; border-left:1rpx solid var(--line); }.meta-value { font-family:Georgia,serif; font-size:39rpx; font-weight:700; }.meta-label { margin-top:5rpx; color:var(--muted); font-size:21rpx; }.warning { margin-top:28rpx; padding:24rpx; display:flex; flex-direction:column; gap:10rpx; color:#665b4c; background:#f5e9d5; border-radius:22rpx; font-size:23rpx; line-height:1.55; }.warning-title { color:#9d5d37; font-weight:700; }.tabs { margin-top:38rpx; display:flex; border-bottom:1rpx solid var(--line); }.tab { flex:1; height:75rpx; margin:0; color:var(--muted); background:transparent; border-radius:0; font-size:27rpx; line-height:75rpx; }.tab.active { color:var(--ink); border-bottom:5rpx solid var(--orange); font-weight:700; }.list-card { padding-top:13rpx; }.ingredient-row { min-height:77rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; border-bottom:1rpx solid var(--line); }.ingredient-name { font-size:26rpx; font-weight:600; }.ingredient-amount { max-width:58%; color:var(--muted); font-size:22rpx; text-align:right; }.optional-badge { margin-left:10rpx; padding:4rpx 8rpx; color:#8c6948; background:#f3e8d7; border-radius:8rpx; font-size:18rpx; }.list-footnote { margin-top:20rpx; display:block; color:var(--muted); font-size:21rpx; line-height:1.6; }.steps-list { padding-top:24rpx; }.step-row { padding:0 0 28rpx; display:flex; gap:22rpx; }.step-no { flex:none; width:48rpx; height:48rpx; color:#fff; background:var(--green); border-radius:50%; font-family:Georgia,serif; font-size:24rpx; text-align:center; line-height:48rpx; }.step-text { flex:1; padding-top:5rpx; font-size:25rpx; line-height:1.75; }.source-link { margin:25rpx 0 0; padding:0; color:var(--green); background:transparent; font-size:23rpx; text-align:left; }.bottom-actions { margin-top:33rpx; display:flex; gap:16rpx; }.bottom-actions button { flex:1; margin:0; }.bottom-actions .secondary-button { height:96rpx; }
